{
  "name": "rcm-titan-asi",
  "version": "7.5.0",
  "description": "RCM AI backend: API, realtime, notifications and background workers",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "worker": "cross-env NODE_ENV=production node workers/ai-processor.js",
    "worker:scheduler": "cross-env NODE_ENV=production node workers/scheduler.js",
    "worker:notification": "cross-env NODE_ENV=production node workers/notificationWorker.js",
    "migrate": "sequelize-cli db:migrate --env production",
    "migrate:undo": "sequelize-cli db:migrate:undo --env production",
    "lint": "eslint . --fix",
    "format": "prettier --write .",
    "test": "jest --detectOpenHandles --forceExit --coverage",
    "reinstall": "npm ci",
    "audit:prod": "npm audit --omit=dev",
    "depcheck": "npx depcheck",
    "docker:build": "docker build -t rcm-titan-asi:stable ."
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "cheerio": "^1.2.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-async-handler": "^1.2.0",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.3.2",
    "firebase-admin": "^13.6.0",
    "fluent-ffmpeg": "^2.1.2",
    "google-auth-library": "^11.0.0",
    "google-tts-api": "^2.0.2",
    "groq-sdk": "^0.7.0",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.11.1",
    "iso8601-duration": "^2.1.4",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^10.2.0",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "mysql2": "^3.9.1",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "nodemailer": "^10.0.10",
    "openai": "^4.77.0",
    "pino": "^8.21.0",
    "pino-http": "^9.0.0",
    "prom-client": "^15.1.3",
    "puppeteer": "^22.15.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "rate-limit-redis": "^4.3.1",
    "razorpay": "^2.9.2",
    "response-time": "^2.3.2",
    "sequelize": "^6.37.0",
    "sequelize-cli": "^6.6.5",
    "sharp": "^0.33.2",
    "socket.io": "^4.7.4",
    "streamifier": "^0.1.1",
    "string-similarity": "^4.0.4",
    "toobusy-js": "^0.5.1",
    "uuid": "^9.0.1",
    "validator": "^13.11.0",
    "ws": "^8.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "clinic": "^13.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.0.10",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.1",
    "nodemon": "^3.0.3",
    "pino-pretty": "^10.3.1",
    "prettier": "^3.2.4",
    "supertest": "^6.3.4"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "semver": "^7.5.2",
    "debug": "^4.3.4",
    "whatwg-url": "^14.0.0"
  },
  "private": true
}
